import os
import re
from pathlib import Path
from typing import List

from PIL import Image, ImageDraw, ImageFont
from gtts import gTTS
from moviepy.editor import AudioFileClip, CompositeVideoClip, ImageClip, TextClip

from config import AUDIOS_DIR, IMAGES_DIR, VIDEOS_DIR


class VideoProcessor:
    def create_short_video(self, topic: str, title: str, script: str) -> str:
        safe_name = self.slugify(title or topic)
        audio_path = os.path.join(AUDIOS_DIR, f"{safe_name}.mp3")
        image_path = self.create_background_image(topic, safe_name)

        speech = gTTS(text=script, lang="en", slow=False)
        speech.save(audio_path)

        audio = AudioFileClip(audio_path)
        duration = max(20, min(35, round(audio.duration)))

        image = ImageClip(image_path, duration=duration)
        image = image.resize(height=1920)
        image = image.resize(width=1080)

        captions = self.build_captions(script, duration)
        subtitle_clips = []
        start_time = 0

        for caption in captions:
            text_clip = TextClip(
                caption.upper(),
                fontsize=52,
                color="white",
                stroke_color="black",
                stroke_width=4,
                method="caption",
                align="center",
                font="DejaVu-Sans-Bold",
                size=(900, None),
            )
            text_clip = text_clip.set_position(("center", "bottom")).set_duration(max(2.5, duration / max(len(captions), 1)))
            text_clip = text_clip.set_start(start_time)
            subtitle_clips.append(text_clip)
            start_time += max(2.5, duration / max(len(captions), 1))

        final_video = CompositeVideoClip([image] + subtitle_clips, size=(1080, 1920))
        final_video = final_video.set_audio(audio)

        output_path = os.path.join(VIDEOS_DIR, f"{safe_name}.mp4")
        final_video.write_videofile(
            output_path,
            fps=30,
            codec="libx264",
            audio_codec="aac",
            threads=4,
            preset="veryfast",
            logger=None,
        )

        return output_path

    def create_background_image(self, topic: str, safe_name: str) -> str:
        image_path = os.path.join(IMAGES_DIR, f"{safe_name}.png")
        width, height = 1080, 1920
        img = Image.new("RGB", (width, height), color=(15, 15, 20))
        draw = ImageDraw.Draw(img)

        for y in range(0, height, 70):
            color_value = 12 + (y // 70) % 35
            draw.rectangle([0, y, width, y + 70], fill=(color_value, 24, 52))

        draw.ellipse((120, 140, 980, 900), fill=(255, 111, 68))
        draw.ellipse((580, 900, 1020, 1360), fill=(80, 150, 255))

        try:
            font = ImageFont.truetype("DejaVuSans-Bold.ttf", 86)
            small_font = ImageFont.truetype("DejaVuSans.ttf", 48)
        except Exception:
            font = ImageFont.load_default()
            small_font = ImageFont.load_default()

        wrapped = self.wrap_text(topic, 14)
        y_pos = 170
        for line in wrapped[:3]:
            draw.text((100, y_pos), line.upper(), fill=(255, 255, 255), font=font)
            y_pos += 110

        draw.text((100, 1500), "AI SHORTS", fill=(240, 240, 240), font=small_font)
        img.save(image_path)
        return image_path

    def wrap_text(self, text: str, max_chars: int) -> List[str]:
        words = text.split()
        lines = []
        current = ""
        for word in words:
            if len(current) + len(word) + 1 <= max_chars:
                current = f"{current} {word}".strip()
            else:
                lines.append(current)
                current = word
        if current:
            lines.append(current)
        return lines

    def build_captions(self, script: str, duration: float) -> List[str]:
        sentences = re.split(r"(?<=[.!?])\s+", script.strip())
        captions = [s.strip() for s in sentences if s.strip()]
        if not captions:
            captions = [script.strip()]

        max_sentences = min(5, len(captions))
        final = captions[:max_sentences]
        if len(final) == 1:
            return [final[0]]
        return final

    def slugify(self, text: str) -> str:
        text = text.lower()
        text = re.sub(r"[^a-z0-9]+", "-", text)
        text = re.sub(r"-+", "-", text).strip("-")
        return text or "ai-short"
